<!DOCTYPE html>
<html lang="pt-BR">

<head>

<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">

<title>Autec | Engenharia Elétrica e Automação Industrial em BH</title>

<meta name="description"
content="A Autec oferece soluções em engenharia elétrica, automação industrial, NR12, montagem de painéis elétricos, projetos industriais e casas inteligentes em Belo Horizonte e região metropolitana.">

<meta name="keywords"
content="automação industrial bh, engenharia elétrica belo horizonte, NR12, painéis elétricos, automação residencial, projetos elétricos, casas inteligentes">

<meta name="author" content="Autec">

<meta property="og:title" content="Autec | Engenharia Elétrica e Automação">
<meta property="og:description"
content="Soluções em engenharia elétrica, automação industrial, NR12 e tecnologia aplicada.">

<meta property="og:type" content="website">

<link rel="icon" type="image/png" href="favicon.png?v=4">

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>

<link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@400;500;600;700;800&display=swap"
rel="stylesheet">

<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
rel="stylesheet">

<link rel="stylesheet"
href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css">

<style>

:root{
--primary:#003b82;
--primary-hover:#0056b8;
--dark:#111827;
--gray:#6b7280;
--light:#f8fafc;
--white:#ffffff;
--border:#e5e7eb;
}

*{
margin:0;
padding:0;
box-sizing:border-box;
scroll-behavior:smooth;
}

body{
font-family:'Montserrat',sans-serif;
background:var(--light);
color:var(--dark);
overflow-x:hidden;
}

section{
padding:100px 0;
}

.container{
max-width:1200px;
}

h1,h2,h3,h4{
font-weight:700;
}

p{
color:var(--gray);
line-height:1.8;
}

.navbar{
background:rgba(255,255,255,0.95);
backdrop-filter:blur(12px);
padding:5px 0;
border-bottom:1px solid rgba(0,0,0,0.05);
transition:.3s;
}

.navbar-brand img{
height:120px;
width:auto;
}

.nav-link{
color:var(--dark)!important;
font-weight:600;
margin-left:20px;
transition:.3s;
}

.nav-link:hover{
color:var(--primary)!important;
}

.btn-main{
background:var(--primary);
color:var(--white);
padding:14px 30px;
border-radius:12px;
text-decoration:none;
font-weight:600;
display:inline-flex;
align-items:center;
gap:10px;
transition:.3s;
box-shadow:0 10px 25px rgba(0,59,130,0.15);
}

.btn-main:hover{
background:var(--primary-hover);
transform:translateY(-3px);
color:var(--white);
}

.hero{
padding-top:220px;
padding-bottom:150px;

background:
linear-gradient(rgba(248,250,252,0.82), rgba(248,250,252,0.92)),
url('https://images.unsplash.com/photo-1517048676732-d65bc937f952?q=80&w=1920&auto=format&fit=crop')
center/cover;
}

.hero h1{
font-size:4rem;
font-weight:800;
line-height:1.2;
max-width:850px;
margin-bottom:25px;
}

.hero h1 span{
color:var(--primary);
}

.hero p{
max-width:700px;
font-size:1.1rem;
margin-bottom:40px;
}

.section-title{
margin-bottom:60px;
}

.section-title h2{
font-size:2.5rem;
margin-bottom:20px;
}

.section-title span{
color:var(--primary);
}

.service-card{
background:var(--white);
padding:40px 30px;
border-radius:18px;
border:1px solid var(--border);
height:100%;
transition:.4s ease;
box-shadow:0 10px 30px rgba(0,0,0,0.03);
}

.service-card:hover{
transform:translateY(-10px);
box-shadow:0 20px 40px rgba(0,59,130,0.08);
border-color:rgba(0,59,130,0.2);
}

.service-icon{
width:70px;
height:70px;
display:flex;
align-items:center;
justify-content:center;
border-radius:16px;
background:rgba(0,59,130,0.08);
margin-bottom:25px;
font-size:1.8rem;
color:var(--primary);
}

.service-img{
width:100%;
height:220px;
object-fit:cover;
border-radius:14px;
margin-bottom:25px;
transition:.5s;
}

.service-card:hover .service-img{
transform:scale(1.03);
}

.service-card h4{
margin-bottom:15px;
font-size:1.3rem;
}

.projects{
background:#f1f5f9;
}

.project-image{
overflow:hidden;
border-radius:18px;
}

.project-image img{
width:100%;
height:100%;
object-fit:cover;
transition:.5s;
}

.project-image:hover img{
transform:scale(1.08);
}

.about{
background:var(--white);
}

.about-image img{
border-radius:20px;
box-shadow:0 20px 50px rgba(0,0,0,0.08);
}

.contact-box{
background:var(--white);
padding:60px;
border-radius:24px;
box-shadow:0 15px 40px rgba(0,0,0,0.05);
}

footer{
background:#0f172a;
padding:60px 0;
}

footer p,
footer a{
color:#cbd5e1;
text-decoration:none;
}

footer a:hover{
color:#ffffff;
}

.footer-logo{
height:80px;
margin-bottom:20px;
}

.whatsapp-float{
position:fixed;
bottom:25px;
right:25px;
width:70px;
height:70px;
background:#25D366;
color:#fff;
border-radius:50%;
display:flex;
align-items:center;
justify-content:center;
font-size:2rem;
text-decoration:none;
z-index:999;
box-shadow:0 15px 35px rgba(0,0,0,0.2);
transition:.3s;
}

.whatsapp-float:hover{
transform:scale(1.08);
color:#fff;
}

.reveal{
opacity:0;
transform:translateY(40px);
transition:all 1s ease;
}

.reveal.active{
opacity:1;
transform:translateY(0);
}

@media(max-width:992px){

.hero h1{
font-size:3rem;
}

}

@media(max-width:768px){

.hero{
text-align:center;
padding-top:180px;
}

.hero h1{
font-size:2.4rem;
}

.section-title h2{
font-size:2rem;
}

.contact-box{
padding:40px 25px;
}

.nav-link{
margin-left:0;
margin-top:10px;
}

.navbar-brand img{
height:75px;
}

}

</style>

</head>

<body>
